   "source": [
    "## Task 2: Data Leakage Prevention with Perceptual Hashing\n",
    "\n",
    "The JMuBEN/JMuBEN2 dataset combines images that may contain near-duplicates\n",
    "(different crops/augmentations of the same source leaf). We use perceptual hashing\n",
    "to detect near-duplicates and ensure they stay in the same split."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compute perceptual hashes for all images\n",
    "# This may take several minutes for 58k images\n",
    "print('Computing perceptual hashes for all images...')\n",
    "\n",
    "hashes = []\n",
    "labels_list = []\n",
    "\n",
    "for i, example in enumerate(ds):\n",
    "    img = example['image'].convert('RGB').resize((128, 128))\n",
    "    h = imagehash.phash(img, hash_size=16)\n",
    "    hashes.append(h)\n",
    "    labels_list.append(example['label'])\n",
    "    if (i + 1) % 5000 == 0:\n",
    "        print(f'  Processed {i+1}/{len(ds)} images')\n",
    "\n",
    "print(f'Computed {len(hashes)} perceptual hashes')\n",
    "\n",
    "# Cluster near-duplicates using Hamming distance\n",
    "HAMMING_THRESHOLD = 10  # images with Hamming distance below this are near-duplicates\n",
    "\n",
    "print(f'Clustering near-duplicates (threshold={HAMMING_THRESHOLD})...')\n",
    "\n",
    "visited = set()\n",
    "clusters = []\n",
    "\n",
    "for i in range(len(hashes)):\n",
    "    if i in visited:\n",
    "        continue\n",
    "    cluster = {i}\n",
    "    visited.add(i)\n",
    "    for j in range(i + 1, len(hashes)):\n",
    "        if j not in visited:\n",
    "            if hashes[i] - hashes[j] <= HAMMING_THRESHOLD:\n",
    "                cluster.add(j)\n",
    "                visited.add(j)\n",
    "    clusters.append(cluster)\n",
    "\n",
    "print(f'Found {len(clusters)} unique image clusters')\n",
    "print(f'  Singleton clusters: {sum(1 for c in clusters if len(c) == 1)}')\n",
    "print(f'  Multi-image clusters: {sum(1 for c in clusters if len(c) > 1)}')\n",
    "print(f'  Largest cluster: {max(len(c) for c in clusters)} images')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create source-aware stratified split (70/15/15)\n",
    "# All images in a cluster go to the same split\n",
    "\n",
    "from collections import Counter\n",
    "\n",
    "# Get cluster labels (majority label per cluster)\n",
    "cluster_labels = []\n",
    "for cluster in clusters:\n",
    "    cluster_label_counts = Counter(labels_list[i] for i in cluster)\n",
    "    cluster_labels.append(cluster_label_counts.most_common(1)[0][0])\n",
    "\n",
    "# Stratified split at cluster level\n",
    "random.seed(SEED)\n",
    "cluster_indices = list(range(len(clusters)))\n",
    "random.shuffle(cluster_indices)\n",
    "\n",
    "# Compute per-class cluster counts for stratification\n",
    "class_cluster_indices = defaultdict(list)\n",
    "for ci, label in zip(cluster_indices, [cluster_labels[ci] for ci in cluster_indices]):\n",
    "    class_cluster_indices[label].append(ci)\n",
    "\n",
    "train_clusters, val_clusters, test_clusters = set(), set(), set()\n",
    "\n",
    "for label, indices in class_cluster_indices.items():\n",
    "    n = len(indices)\n",
    "    n_train = int(n * 0.70)\n",
    "    n_val = int(n * 0.15)\n",
    "    \n",
    "    train_clusters.update(indices[:n_train])\n",
    "    val_clusters.update(indices[n_train:n_train + n_val])\n",
    "    test_clusters.update(indices[n_train + n_val:])\n",
    "\n",
    "# Map cluster assignments back to individual images\n",
    "train_idx = set()\n",
    "val_idx = set()\n",
    "test_idx = set()\n",
    "\n",
    "for ci, cluster in enumerate(clusters):\n",
    "    if ci in train_clusters:\n",
    "        train_idx.update(cluster)\n",
    "    elif ci in val_clusters:\n",
    "        val_idx.update(cluster)\n",
    "    else:\n",
    "        test_idx.update(cluster)\n",
    "\n",
    "print(f'Train: {len(train_idx)} images ({len(train_idx)/len(ds)*100:.1f}%)')\n",
    "print(f'Val:   {len(val_idx)} images ({len(val_idx)/len(ds)*100:.1f}%)')\n",
    "print(f'Test:  {len(test_idx)} images ({len(test_idx)/len(ds)*100:.1f}%)')\n",
    "\n",
    "# Per-class distribution per split\n",
    "for split_name, split_idx in [('Train', train_idx), ('Val', val_idx), ('Test', test_idx)]:\n",
    "    split_labels = Counter(labels_list[i] for i in split_idx)\n",
    "    dist = ' | '.join(f'{class_names[k]}: {v}' for k, v in sorted(split_labels.items()))\n",
    "    print(f'  {split_name}: {dist}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Verify no data leakage between splits\n",
    "print('Verifying no near-duplicate leakage between splits...')\n",
    "\n",
    "train_hashes = {hashes[i] for i in train_idx}\n",
    "val_hashes = {hashes[i] for i in val_idx}\n",
    "test_hashes = {hashes[i] for i in test_idx}\n",
    "\n",
    "# Check exact hash overlap\n",
    "tv_overlap = train_hashes & val_hashes\n",
    "tt_overlap = train_hashes & test_hashes\n",
    "vt_overlap = val_hashes & test_hashes\n",
    "\n",
    "print(f'Train-Val exact hash overlap: {len(tv_overlap)}')\n",
    "print(f'Train-Test exact hash overlap: {len(tt_overlap)}')\n",
    "print(f'Val-Test exact hash overlap: {len(vt_overlap)}')\n",
    "\n",
    "# Check near-duplicate overlap (Hamming distance <= threshold)\n",
    "def check_near_dup_overlap(hashes_a, indices_a, hashes_b, indices_b, threshold=HAMMING_THRESHOLD):\n",
    "    count = 0\n",
    "    hash_list_a = [hashes_a[i] for i in indices_a]\n",
    "    hash_list_b = [hashes_b[i] for i in indices_b]\n",
    "    for ha in hash_list_a:\n",
    "        for hb in hash_list_b:\n",
    "            if ha - hb <= threshold:\n",
    "                count += 1\n",
    "    return count\n",
    "\n",
    "# Sample check (full check would be too slow for 58k images)\n",
    "sample_train = list(train_idx)[:500]\n",
    "sample_val = list(val_idx)[:500]\n",
    "sample_test = list(test_idx)[:500]\n",
    "\n",
    "tv_nd = check_near_dup_overlap(hashes, sample_train, hashes, sample_val)\n",
    "tt_nd = check_near_dup_overlap(hashes, sample_train, hashes, sample_test)\n",
    "vt_nd = check_near_dup_overlap(hashes, sample_val, hashes, sample_test)\n",
    "\n",
    "print(f'\\nNear-duplicate overlap (500-image samples, threshold={HAMMING_THRESHOLD}):')\n",
    "print(f'  Train-Val: {tv_nd}')\n",
    "print(f'  Train-Test: {tt_nd}')\n",
    "print(f'  Val-Test: {vt_nd}')\n",
    "print('\\nData leakage prevention: PASSED' if tv_nd == 0 and tt_nd == 0 and vt_nd == 0 else 'WARNING: Potential leakage detected')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Task 3: Data Preprocessing & Augmentation Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define transforms\n",
    "IMAGENET_MEAN = [0.485, 0.456, 0.406]\n",
    "IMAGENET_STD = [0.229, 0.224, 0.225]\n",
    "\n",
    "train_transform = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),\n",
    "    transforms.RandomHorizontalFlip(),\n",
    "    transforms.RandomVerticalFlip(),\n",
    "    transforms.RandomRotation(15),\n",
    "    transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2, hue=0.05),\n",
    "    transforms.RandomAffine(degrees=0, translate=(0.1, 0.1), scale=(0.9, 1.1)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n",
    "])\n",
    "\n",
    "eval_transform = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n",
    "])\n",
    "\n",
    "# Custom Dataset class\n",
    "class CoffeeLeafDataset(Dataset):\n",
    "    def __init__(self, hf_dataset, indices, transform=None, oversample_classes=None, oversample_factor=2):\n",
    "        self.dataset = hf_dataset\n",
    "        self.indices = list(indices)\n",
    "        self.transform = transform\n",
    "        self.oversample_classes = oversample_classes or []\n",
    "        self.oversample_factor = oversample_factor\n",
    "        \n",
    "        # Build index list with oversampling for minority classes\n",
    "        if oversample_classes:\n",
    "            augmented_indices = list(self.indices)\n",
    "            for idx in self.indices:\n",
    "                label = self.dataset[idx]['label']\n",
    "                if label in oversample_classes:\n",
    "                    augmented_indices.extend([idx] * (oversample_factor - 1))\n",
    "            self.indices = augmented_indices\n",
    "        \n",
    "    def __len__(self):\n",
    "        return len(self.indices)\n",
    "    \n",
    "    def __getitem__(self, idx):\n",
    "        example = self.dataset[self.indices[idx]]\n",
    "        img = example['image'].convert('RGB')\n",
    "        label = example['label']\n",
    "        if self.transform:\n",
    "            img = self.transform(img)\n",
    "        return img, label\n",
    "\n",
    "# Minority classes: Cercospora (0) and Phoma (4)\n",
    "MINORITY_CLASSES = [0, 4]  # Cercospora, Phoma\n",
    "\n",
    "train_dataset = CoffeeLeafDataset(ds, train_idx, train_transform, \n",
    "                                   oversample_classes=MINORITY_CLASSES, oversample_factor=2)\n",
    "val_dataset = CoffeeLeafDataset(ds, val_idx, eval_transform)\n",
    "test_dataset = CoffeeLeafDataset(ds, test_idx, eval_transform)\n",
    "\n",
    "BATCH_SIZE = 32\n",
    "NUM_WORKERS = 2\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=NUM_WORKERS, pin_memory=True)\n",
    "val_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=True)\n",
    "test_loader = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=True)\n",
    "\n",
    "# Verify batch shapes\n",
    "images, labels = next(iter(train_loader))\n",
    "print(f'Train batch — images: {images.shape}, labels: {labels.shape}')\n",
    "print(f'Train dataset size (with oversampling): {len(train_dataset)}')\n",
    "print(f'Val dataset size: {len(val_dataset)}')\n",
    "print(f'Test dataset size: {len(test_dataset)}')"
   ]
  },
