# Abole Coffee Leaf Disease Detection API - Environment Configuration
# Copy this file to .env and adjust values as needed.

# API Authentication
API_KEY=dr-buna-demo-key-change-me

# Model Paths
MODEL_PATH=../model/efficientnet_b0_coffee.onnx
LABEL_MAPPING_PATH=../model/label_mapping.json
DISEASE_INFO_PATH=./data/disease_info.json

# Image Constraints
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
MAX_IMAGE_SIZE_MB=10.0
WARNING_MIN_RESOLUTION_PX=256
WARNING_MAX_FILE_SIZE_MB=5.0

# Inference - demo mode returns placeholder predictions if no ONNX model found
DEMO_MODE=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
